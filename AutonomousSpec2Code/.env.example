# Autonomous Spec-to-Code Pipeline Configuration
# ==================================================
# Mode can be "mock" (deterministic self-correction learning simulator) or "openai" (any OpenAI-compatible API)
SPEC2CODE_LLM_PROVIDER=mock

# OpenAI / Compatible API settings (used when SPEC2CODE_LLM_PROVIDER=openai)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=[https://api.openai.com/v1](https://api.openai.com/v1)
SPEC2CODE_MODEL=gpt-4o-mini
SPEC2CODE_JUDGE_MODEL=gpt-4o-mini

# Pipeline Execution & Sandbox Settings
SPEC2CODE_MAX_RETRIES=3
SPEC2CODE_SANDBOX_TIMEOUT_SECONDS=10