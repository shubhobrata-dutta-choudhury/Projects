# ==============================================================================
# FinFlow-Engine Environment Configuration
# ==============================================================================

# Execution Mode: "mock" (deterministic financial reasoning without API keys) or "openai"
FINFLOW_LLM_MODE=mock

# LLM Provider Settings (Required when FINFLOW_LLM_MODE=openai)
OPENAI_API_KEY=sk-your-openai-api-key
FINFLOW_PRIMARY_MODEL=gpt-4o
FINFLOW_FALLBACK_MODEL=gpt-4o-mini

# Redis Infrastructure (Uses fakeredis automatically if Redis server is unreachable and FINFLOW_REDIS_FALLBACK_MEMORY=true)
FINFLOW_REDIS_URL=redis://localhost:6379/0
FINFLOW_REDIS_FALLBACK_MEMORY=true
FINFLOW_CACHE_TTL_SECONDS=3600
FINFLOW_IDEMPOTENCY_TTL_SECONDS=86400

# Circuit Breaker & Retry Policy
FINFLOW_CB_FAILURE_THRESHOLD=3
FINFLOW_CB_RECOVERY_TIMEOUT_SECONDS=30
FINFLOW_MAX_RETRIES=3
FINFLOW_BASE_BACKOFF_SECONDS=0.5

# Risk & Compliance Gatekeeper Thresholds
FINFLOW_MAX_PORTFOLIO_VAR_95_PCT=3.5
FINFLOW_MAX_SINGLE_ASSET_WEIGHT_PCT=40.0
FINFLOW_MAX_CRITIC_REFLECTION_HOPS=2

# Langfuse Observability & Evaluation
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000
